# API manzili (ixtiyoriy — app.json dagi extra.apiUrl dan ham sozlanadi)
# Haqiqiy telefon uchun kompyuterning lokal IP manzilini yozing, masalan:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
# Android emulator uchun localhost ishlamaydi, 10.0.2.2 ishlatiladi (kodda avtomatik).
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_EAS_PROJECT_ID=
